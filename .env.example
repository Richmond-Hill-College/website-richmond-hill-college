# Richmond Hill College — environment variables
# Copy to .env.local for local dev, or set in Vercel Project Settings.
# Values shown here are placeholders; replace with real ones before use.

# ─── Site ──────────────────────────────────────────────────────────────────
# Canonical site URL (no trailing slash). Used in sitemap, OG tags, canonicals.
NEXT_PUBLIC_SITE_URL=https://www.richmondhillcollege.ca

# ─── Database (Neon) ───────────────────────────────────────────────────────
# Get a free Postgres database at https://console.neon.tech
# Use the "Pooled connection" string for serverless functions.
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Required for the contact form to deliver notifications.
# Sign up at https://resend.com — verify your domain to send from @richmondhillcollege.ca
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# Where contact-form submissions are routed
CONTACT_NOTIFY_EMAIL=info@richmondhillcollege.ca
# From address (must be a verified Resend sender)
CONTACT_FROM_EMAIL=Richmond Hill College <noreply@richmondhillcollege.ca>

# ─── Privacy ───────────────────────────────────────────────────────────────
# Secret used to hash IPs before storing them with submissions.
# Pick a long random string; rotating invalidates correlation across rotations.
IP_HASH_SECRET=change-me-to-a-long-random-string

# ─── WhatsApp ──────────────────────────────────────────────────────────────
# Phone number behind the floating WhatsApp button (E.164, digits only).
NEXT_PUBLIC_WHATSAPP_PHONE=16476433712

# ─── Analytics (GA4) ───────────────────────────────────────────────────────
# Optional. When unset, GA4 doesn't load. When set, it loads only after the
# user accepts cookies via the CookiesBanner.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Eventbrite ────────────────────────────────────────────────────────────
# API credentials for fetching events on the homepage.
# Get these from https://www.eventbrite.com/platform/ (OAuth app settings).
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_API_KEY=
EVENTBRITE_CLIENT_SECRET=
EVENTBRITE_PUBLIC_TOKEN=

# ─── Error tracking (Sentry) ───────────────────────────────────────────────
# Optional. When NEXT_PUBLIC_SENTRY_DSN is unset, Sentry init is skipped and
# the next.config Sentry wrapper is bypassed (no source-map upload required).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
